#!/usr/bin/env bash

# Start MailHog in the background if not already running
if ! pgrep -f "mailhog" > /dev/null; then
  echo "📬 Starting MailHog..."
  if command -v docker > /dev/null; then
    docker run -d --name mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog > /dev/null 2>&1
    echo "✅ MailHog started via Docker (Web UI: http://localhost:8025)"
  elif command -v mailhog > /dev/null; then
    mailhog > /dev/null 2>&1 &
    echo "✅ MailHog started (Web UI: http://localhost:8025)"
  else
    echo "⚠️  MailHog not found. Install with: docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog"
    echo "   Or: brew install mailhog"
  fi
else
  echo "📬 MailHog is already running (Web UI: http://localhost:8025)"
fi

# Start Rails server
echo "🚂 Starting Rails server..."
exec bin/rails server
